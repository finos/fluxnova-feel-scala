<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.finos.fluxnova.feel</groupId>
  <artifactId>feel-engine</artifactId>
  <version>3.0.0-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>FEEL Scala Engine</name>

  <url>http://fluxnova.finos.org</url>

  <organization>
    <name>Fluxnova Community</name>
    <url>http://fluxnova.finos.org</url>
  </organization>

  <developers>
    <developer>
      <id>fluxnova.finos.org</id>
      <name>Fluxnova Community</name>
      <organization>fluxnova.finos.org</organization>
      <organizationUrl>http://fluxnova.finos.org</organizationUrl>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/finos/fluxnova-feel-scala.git</connection>
    <developerConnection>scm:git:https://github.com/finos/fluxnova-feel-scala.git</developerConnection>
    <url>https://github.com/finos/fluxnova-feel-scala</url>
    <tag>HEAD</tag>
  </scm>

  <issueManagement>
    <system>GitHub Issues</system>
    <url>https://github.com/orgs/finos/projects/116</url>
  </issueManagement>

  <properties>
    <!-- encoding -->
    <encoding>UTF-8</encoding>
    <project.build.sourceEncoding>${encoding}</project.build.sourceEncoding>
    <project.build.resourceEncoding>${encoding}</project.build.resourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- we use java 21 for our projects (from fluxnova-release-parent) -->
    <version.java>21</version.java>

    <!-- scala / feel-engine specific -->
    <scala.version>2.13.18</scala.version>
    <scala.binary.version>2.13.6</scala.binary.version>
    <version.log4j>2.24.2</version.log4j>
    <version.uuid>5.2.0</version.uuid>

    <!-- release / publishing (from fluxnova-release-parent) -->
    <skip.camunda.release>false</skip.camunda.release>
    <skip.central.release>false</skip.central.release>
    <gpg.useagent>true</gpg.useagent>
    <gpg.executable>gpg</gpg.executable>
    <publish.server.id>ossrh</publish.server.id>
    <release.goals>install org.sonatype.central:central-publishing-maven-plugin:0.7.0:publish</release.goals>
    <skip.source.attach>false</skip.source.attach>

    <!-- third-party license bom (from fluxnova-bpm-release-parent, overridden here to generate the bom) -->
    <skip-third-party-bom>false</skip-third-party-bom>
    <third-party-bom-scopes>compile</third-party-bom-scopes>
    <license.inlineHeader>
Copyright Camunda Services GmbH and/or licensed to Camunda Services GmbH
under one or more contributor license agreements. See the NOTICE file
distributed with this work for additional information regarding copyright
ownership. Camunda licenses this file to you under the Apache License,
Version 2.0; you may not use this file except in compliance with the License.
